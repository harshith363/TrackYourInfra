---
import Base from '../../layouts/Base.astro';
import MapExplorer from '../../components/MapExplorer.astro';
import { data, formatCost, formatDate, getAgency, getCity, getSource, getState, statusLabel } from '../../lib/data';
export function getStaticPaths() { return data.projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const city = getCity(project.cityId)!;
const state = getState(project.stateId)!;
const agency = getAgency(project.agencyId)!;
const sources = project.sourceIds.map((id: string) => getSource(id)!);
const real = project.recordKind === 'real';
---
<Base title={project.name} description={project.summary}>
  <div class="shell project-hero"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">India</a><span>/</span><a href={`/states/${state.id}/`}>{state.name}</a><span>/</span><a href={`/states/${state.id}/cities/${city.id}/`}>{city.name}</a><span>/</span><span>Project</span></nav><div class="section-label">PROJECT RECORD <span class="label-line"></span> {project.line.toUpperCase()}</div><div class="project-hero-line"><div><h1>{project.name}<em>.</em></h1><p>{project.summary}</p></div><div class="hero-status"><span class={`status status-${project.status ?? 'unknown'}`}>{statusLabel(project.status)}</span><small>{project.statusAsOf ? `As of ${formatDate(project.statusAsOf)}` : 'Status date not established'}<br />{project.confidence ?? 'Unrated'} confidence · {real ? 'source-backed' : 'demo data'}</small></div></div>{real ? <div class="demo-banner"><span class="demo-icon" aria-hidden="true">i</span> Community-submitted facts may be published after format checks without independent evidence review. Check the linked sources. <a href="/methodology/">Read the methodology</a>.</div> : <div class="demo-banner"><span class="demo-icon" aria-hidden="true">i</span> All facts on this page are invented to demonstrate the interface. <a href="/methodology/#demonstration-data">Read why</a>.</div>}</div>
  <section class="shell project-metrics" aria-label="Project at a glance"><div><span>ROUTE LENGTH</span><strong>{project.routeLengthKm === null ? 'Not reported' : <>{project.routeLengthKm} <small>km</small></>}</strong></div><div><span>STATIONS</span><strong>{project.stationCount ?? 'Not reported'}</strong></div><div><span>APPROVED COST</span><strong>{formatCost(project.approvedCostCrore)}</strong></div><div><span>LATEST COST</span><strong>{formatCost(project.latestCostCrore)}</strong></div><div><span>CURRENT TARGET</span><strong>{formatDate(project.currentTarget)}</strong></div><div><span>PROGRESS</span><strong>{project.progressPercent === null ? 'Not reported' : `${project.progressPercent}%`}</strong></div></section>
  <div class="shell project-history-link"><a href={`/projects/${project.slug}/history/`}>View change history ↗</a></div>
  <div class="shell project-content"><div class="project-main"><section class="detail-section"><div class="section-label">01 / THE ROUTE</div><h2>Where it goes.</h2><p>{real ? project.scopeDescription : "The line below is an illustrative shape for interface testing. It is not a surveyed route alignment."}</p>{real && !project.geometry && !project.routeProposal && <p>No reviewed route geometry is available yet. The city marker shows context only, not an alignment.</p>}{real && project.routeProposal && <div class="proposal-note"><strong>Unverified community route proposal.</strong> The dashed orange line is {project.routeProposal.precision} and is not an official or surveyed alignment. Drawn by <a href={`https://github.com/${encodeURIComponent(project.routeProposal.creator)}`}>@{project.routeProposal.creator}</a>; <a href={project.routeProposal.issueUrl}>see the submission</a>. Shared under <a href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a>.</div>}<MapExplorer initialState={state.id} initialCity={city.id} compact />{project.stations.length > 0 && <div class="station-list"><h3>{real ? "Stations in scope" : "Illustrative stations"}</h3><ol>{project.stations.map((station: string) => <li>{station}</li>)}</ol></div>}</section><section class="detail-section"><div class="section-label">02 / THE TIMELINE</div><h2>What changed.</h2><div class="timeline">{project.milestones.map((milestone: any) => <article class="timeline-item"><time datetime={milestone.date}>{formatDate(milestone.date)}</time><div><h3>{milestone.title}</h3><p>{milestone.description}</p><a href={`#source-${milestone.sourceId}`}>View source ↗</a></div></article>)}</div></section><section class="detail-section" id="sources"><div class="section-label">03 / EVIDENCE</div><h2>Source register.</h2><p>{real ? "Primary documents and the claim-specific evidence used for this record." : "These examples point to the demonstration note."}</p>{real && <div class="source-list">{Object.entries(project.claimEvidence ?? {}).map(([field, evidence]: [string, any]) => <article class="source-row"><span class="source-type">{field.replaceAll(/([A-Z])/g, " $1")}</span><div><h3>{evidence.confidence} confidence</h3><p>{evidence.qualifier ?? "Supported by linked sources."}</p><p>{evidence.sourceIds.map((id: string) => <a href={`#source-${id}`}>{getSource(id)?.title} ↗ </a>)}</p></div></article>)}</div>}<div class="source-list">{sources.map((source: any) => <article id={`source-${source.id}`} class="source-row"><span class="source-type">{source.type}</span><div><h3><a href={source.url}>{source.title} ↗</a></h3><p>{source.publisher} · {formatDate(source.publishedAt)}{source.section ? ` · ${source.section}` : ""}</p><p>{source.description}</p></div></article>)}</div></section></div><aside class="project-sidebar"><div class="sidebar-card"><div class="section-label">PROJECT FILE</div><dl><div><dt>City</dt><dd><a href={`/states/${state.id}/cities/${city.id}/`}>{city.name}</a></dd></div><div><dt>State</dt><dd><a href={`/states/${state.id}/`}>{state.name}</a></dd></div><div><dt>Agency</dt><dd>{agency.name}</dd></div><div><dt>Original target</dt><dd>{formatDate(project.originalTarget)}</dd></div><div><dt>Current target</dt><dd>{formatDate(project.currentTarget)}</dd></div><div><dt>Last updated</dt><dd>{formatDate(project.updatedAt)}</dd></div></dl></div><div class="sidebar-note"><span>↗</span><h3>Help improve this record.</h3><p>Draw an approximate route proposal or learn how to submit a source-backed correction.</p><a href={`/contribute/map/?project=${encodeURIComponent(project.id)}`}>Draw a route ↗</a><br /><a href="/contribute/">More ways to contribute ↗</a></div></aside></div>
</Base>
<style>.project-history-link{padding-top:15px;text-align:right}.project-history-link a{font-size:11px;font-weight:800;color:#23816c}.proposal-note{border:1px solid #e9c3a2;background:#fff4e8;padding:14px 18px;margin:18px 0;border-radius:9px;color:#674323;line-height:1.6}.proposal-note a{color:#9a4f1d;text-decoration:underline}</style>
