---
import Base from '../../layouts/Base.astro';
import MapExplorer from '../../components/MapExplorer.astro';
import { data, formatCost, formatDate, getAgency, getCity, getSource, getState, statusLabel } from '../../lib/data';
export function getStaticPaths() { return data.projects.map((project) => ({ params: { slug: project.slug }, props: { project } })); }
const { project } = Astro.props;
const city = getCity(project.cityId)!;
const state = getState(project.stateId)!;
const agency = getAgency(project.agencyId)!;
const sources = project.sourceIds.map((id: string) => getSource(id)!);
---
<Base title={project.name} description={project.summary}>
  <div class="shell project-hero"><nav class="breadcrumb" aria-label="Breadcrumb"><a href="/">India</a><span>/</span><a href={`/states/${state.id}/`}>{state.name}</a><span>/</span><a href={`/states/${state.id}/cities/${city.id}/`}>{city.name}</a><span>/</span><span>Project</span></nav><div class="section-label">PROJECT RECORD <span class="label-line"></span> {project.line.toUpperCase()}</div><div class="project-hero-line"><div><h1>{project.name}<em>.</em></h1><p>{project.summary}</p></div><div class="hero-status"><span class={`status status-${project.status}`}>{statusLabel(project.status)}</span><small>As of {formatDate(project.statusAsOf)}<br />Low confidence · demo data</small></div></div><div class="demo-banner"><span class="demo-icon" aria-hidden="true">i</span> All facts on this page are invented to demonstrate the interface. <a href="/methodology/#demonstration-data">Read why</a>.</div></div>
  <section class="shell project-metrics" aria-label="Project at a glance"><div><span>ROUTE LENGTH</span><strong>{project.routeLengthKm} <small>km</small></strong></div><div><span>STATIONS</span><strong>{project.stationCount}</strong></div><div><span>APPROVED COST</span><strong>{formatCost(project.approvedCostCrore)}</strong></div><div><span>LATEST COST</span><strong>{formatCost(project.latestCostCrore)}</strong></div><div><span>CURRENT TARGET</span><strong>{formatDate(project.currentTarget)}</strong></div><div><span>PROGRESS</span><strong>{project.progressPercent === null ? 'Not reported' : `${project.progressPercent}%`}</strong></div></section>
  <div class="shell project-content"><div class="project-main"><section class="detail-section"><div class="section-label">01 / THE ROUTE</div><h2>Where it goes.</h2><p>The line below is an illustrative shape for interface testing. It is not a surveyed route alignment.</p><MapExplorer initialState={state.id} initialCity={city.id} compact /><div class="station-list"><h3>Illustrative stations</h3><ol>{project.stations.map((station: string) => <li>{station}</li>)}</ol></div></section><section class="detail-section"><div class="section-label">02 / THE TIMELINE</div><h2>What changed.</h2><div class="timeline">{project.milestones.map((milestone: any) => <article class="timeline-item"><time datetime={milestone.date}>{formatDate(milestone.date)}</time><div><h3>{milestone.title}</h3><p>{milestone.description}</p><a href={`#source-${milestone.sourceId}`}>Source: demonstration data note ↗</a></div></article>)}</div></section><section class="detail-section" id="sources"><div class="section-label">03 / EVIDENCE</div><h2>Source register.</h2><p>Each published claim will point to its supporting documents and dates. These examples point to the demonstration note.</p><div class="source-list">{sources.map((source: any) => <article id={`source-${source.id}`} class="source-row"><span class="source-type">{source.type}</span><div><h3><a href={source.url}>{source.title} ↗</a></h3><p>{source.publisher} · {formatDate(source.publishedAt)}</p><p>{source.description}</p></div></article>)}</div></section></div><aside class="project-sidebar"><div class="sidebar-card"><div class="section-label">PROJECT FILE</div><dl><div><dt>City</dt><dd><a href={`/states/${state.id}/cities/${city.id}/`}>{city.name}</a></dd></div><div><dt>State</dt><dd><a href={`/states/${state.id}/`}>{state.name}</a></dd></div><div><dt>Agency</dt><dd>{agency.name}</dd></div><div><dt>Original target</dt><dd>{formatDate(project.originalTarget)}</dd></div><div><dt>Current target</dt><dd>{formatDate(project.currentTarget)}</dd></div><div><dt>Last updated</dt><dd>{formatDate(project.updatedAt)}</dd></div></dl></div><div class="sidebar-note"><span>↗</span><h3>Help improve this record.</h3><p>Community submissions and review will be added in Phase 2. For now, learn how the evidence model works.</p><a href="/methodology/#contribute">Contribution approach ↗</a></div></aside></div>
</Base>
